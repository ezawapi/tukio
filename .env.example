# Variables publiques requises au moment du build (Netlify, Vercel, Hosting.cd)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Important : certains hébergeurs proposent VITE_SUPABASE_ANON_KEY par défaut.
# Tukio utilise VITE_SUPABASE_PUBLISHABLE_KEY : créez cette variable avec la
# même clé publique. N'ajoutez jamais de clé service_role au frontend.
